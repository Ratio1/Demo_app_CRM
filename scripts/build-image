#!/usr/bin/env bash
#
# build-image — build demo-crm-app:local with the trust anchor it needs.
#
#   scripts/build-image [ca-cert-path]
#
# Two steps, in order, neither of them optional:
#
#   1. Copy a PostgreSQL CA's PUBLIC certificate to app/certs/ca-bundle.pem,
#      the trust anchor `sslmode=verify-full` uses (app/config.py's
#      CA_BUNDLE_PATH); git-ignored, so a fresh clone has to build it. Only
#      the certificate is read; a CA's private key is never touched here.
#      Source, in order: ../_tools/pgsql/pg ca (parent checkout) when that
#      helper is executable; else this script's first argument; else
#      CA_CERT. A standalone clone needs one of the latter two.
#   2. docker build --target runtime.
#
# That bundle is the *database* connection's trust anchor and nothing else.
# The image holds no server certificate and no private key at all: the
# container serves plain HTTP on port 3000 and a terminator in front of it
# holds the public certificate.

set -Eeuo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
root_dir="$(cd -- "${script_dir}/.." && pwd)"
cd -- "$root_dir"

readonly IMAGE="demo-crm-app:local"
readonly CERT_DIR="app/certs"
readonly BUNDLE="${CERT_DIR}/ca-bundle.pem"
readonly PG="../_tools/pgsql/pg"

mkdir -p -- "$CERT_DIR"

if [ -x "$PG" ]; then
  ca_path="$("$PG" ca)"
elif [ -n "${1:-}" ]; then
  ca_path="$1"
elif [ -n "${CA_CERT:-}" ]; then
  ca_path="$CA_CERT"
else
  printf 'build-image: %s not found; pass a CA certificate path as the\nfirst argument or set CA_CERT.\n' "$PG" >&2
  exit 2
fi

[ -f "$ca_path" ] || { printf 'build-image: CA certificate %s does not exist\n' "$ca_path" >&2; exit 2; }

cp -- "$ca_path" "$BUNDLE"
printf 'build-image: trust anchor written to %s\n' "$BUNDLE" >&2

exec docker build -t "$IMAGE" --target runtime .
