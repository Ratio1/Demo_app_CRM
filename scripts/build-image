#!/usr/bin/env bash
#
# build-image — build demo-crm-app:local with the TLS material it needs.
#
#   scripts/build-image [ca-cert-path]
#
# Three steps, in order, none of them optional:
#
#   1. Copy a PostgreSQL CA's PUBLIC certificate to app/certs/ca-bundle.pem,
#      the trust anchor `sslmode=verify-full` uses (app/config.py's
#      CA_BUNDLE_PATH); git-ignored, so a fresh clone has to build it. Only
#      the certificate is read; a CA's private key is never touched here.
#      Source, in order: ../_tools/pgsql/pg ca (parent checkout) when that
#      helper is executable; else this script's first argument; else
#      CA_CERT. A standalone clone needs one of the latter two.
#   2. Generate a self-signed 127.0.0.1 certificate into app/certs/ if it is
#      not already there — the pair scripts/start turns into uvicorn's
#      --ssl-certfile/--ssl-keyfile. An existing pair is never regenerated:
#      the browser warning the operator already accepted stays accepted.
#   3. docker build --target runtime.
#
# The image serves HTTPS with a certificate no CA signed, so a browser warns
# once per host and port. Accepting that warning once is expected for a local
# run; nothing else about the image is development-only.

set -Eeuo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
root_dir="$(cd -- "${script_dir}/.." && pwd)"
cd -- "$root_dir"

readonly IMAGE="demo-crm-app:local"
readonly CERT_DIR="app/certs"
readonly BUNDLE="${CERT_DIR}/ca-bundle.pem"
readonly CERT_FILE="${CERT_DIR}/dev-server.crt"
readonly KEY_FILE="${CERT_DIR}/dev-server.key"
readonly PG="../_tools/pgsql/pg"

mkdir -p -- "$CERT_DIR"

if [ -x "$PG" ]; then
  ca_path="$("$PG" ca)"
elif [ -n "${1:-}" ]; then
  ca_path="$1"
elif [ -n "${CA_CERT:-}" ]; then
  ca_path="$CA_CERT"
else
  printf 'build-image: %s not found; pass a CA certificate path as the\nfirst argument or set CA_CERT.\n' "$PG" >&2
  exit 2
fi

[ -f "$ca_path" ] || { printf 'build-image: CA certificate %s does not exist\n' "$ca_path" >&2; exit 2; }

cp -- "$ca_path" "$BUNDLE"
printf 'build-image: trust anchor written to %s\n' "$BUNDLE" >&2

if [ ! -f "$CERT_FILE" ] || [ ! -f "$KEY_FILE" ]; then
  printf 'build-image: generating a self-signed development certificate\n' >&2
  openssl req -x509 -newkey rsa:2048 -nodes -days 30 \
    -keyout "$KEY_FILE" \
    -out "$CERT_FILE" \
    -subj "/CN=127.0.0.1" \
    -addext "subjectAltName=IP:127.0.0.1,DNS:localhost"
  chmod 600 "$KEY_FILE"
fi

exec docker build -t "$IMAGE" --target runtime .
