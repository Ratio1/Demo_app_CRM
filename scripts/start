#!/usr/bin/env bash
#
# start — the single command that serves Demo_App_CRM, and the Dockerfile CMD.
# It starts the server and does nothing else: it never migrates, provisions,
# seeds or otherwise touches the database, and it reads no environment variable
# of its own. The five database variables are read once, at lifespan, by
# app/config.py — this script only passes the process the flags that bound it.
#
# Why each flag:
#
#   --host 0.0.0.0 --port 3000   the address the container listens on; the
#                                deployer publishes it.
#   --workers 1                  one worker, so there is no worker manager and
#                                no process supervisor; `exec` below then makes
#                                uvicorn PID 1 and SIGTERM reaches it directly.
#   --no-server-header           no `server:` response header to fingerprint.
#   --no-proxy-headers           X-Forwarded-Host/Proto/For must not influence
#                                any decision or redirect target; the app
#                                compares Origin and Host against the origin
#                                stored in the database instead.
#   --limit-concurrency 64       transport-level last resort only. The app's own
#                                budgets are much tighter — the connection pool
#                                admits 4 active plus 16 waiting and the hash
#                                executor 1 active plus 8 queued (29 in total),
#                                each answering with a sanitized 429 or 503 that
#                                carries a correlation id. 64 sits well above
#                                that sum on purpose: if it were close, uvicorn's
#                                bare 503 would pre-empt the designed responses
#                                and the throttling tests would be asserting
#                                uvicorn's behaviour instead of the app's.
#   --backlog 128                bounded accept queue.
#   --timeout-graceful-shutdown 20
#                                finish in-flight requests on SIGTERM, then stop.
#                                NOTE for scripts/run-local: this exceeds
#                                Docker's default 10 s stop timeout, so the
#                                reference `docker run` needs
#                                `--stop-timeout 25` or docker escalates to
#                                SIGKILL before uvicorn's own window closes.
#
#   --no-access-log              uvicorn's own access line carries the full
#                                request target, query string included, and a
#                                query string can carry a search term or an
#                                email address, which must never reach a log.
#                                app/logging.py emits one JSON record per
#                                request instead, with `path` stripped of the
#                                query.
#
# Every PG* variable is scrubbed before exec. Every
# libpq parameter is passed explicitly by app/config.py, so a hostile PGSSLMODE
# or PGHOST cannot override one — but a PGSERVICE naming a service that does
# not exist is a hard connection failure, and that is an availability lever an
# unprivileged co-tenant of this process's environment could otherwise pull.
#
# `python -B` so nothing writes bytecode on the read-only root filesystem; the
# .pyc files for the dependencies are baked in at build time by pip.
#
# uvicorn's --ssl-certfile/--ssl-keyfile are added below, conditional on BOTH
# app/certs/dev-server.crt and app/certs/dev-server.key being present in the
# image. Without them the container would serve plain HTTP, and then `__Host-`
# cookies (Secure) and the stored HTTPS origin could never match — so the pair is the
# difference between a container that serves and one that refuses every
# request. Nothing else is added: no http:// exception, no reloader, no second
# process, and no environment variable selects TLS — the files decide.

set -Eeuo pipefail

# Every PG* name, unconditionally, before the server starts.
for pg_name in "${!PG@}"; do
  unset "$pg_name"
done
unset pg_name

# Resolved from this script's own location, never from the working directory:
# the image's WORKDIR is /app today, and a cwd-relative path would silently
# become "no certificate" — which reads as a deliberate plain-HTTP run rather
# than as the misconfiguration it is.
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
root_dir="$(cd -- "${script_dir}/.." && pwd)"
cert_file="${root_dir}/app/certs/dev-server.crt"
key_file="${root_dir}/app/certs/dev-server.key"

tls_args=()
if [ -f "$cert_file" ] && [ -f "$key_file" ]; then
  tls_args=(--ssl-certfile "$cert_file" --ssl-keyfile "$key_file")
fi

exec python -B -m uvicorn app.main:app \
  --host 0.0.0.0 \
  --port 3000 \
  --workers 1 \
  --no-server-header \
  --no-proxy-headers \
  --no-access-log \
  --limit-concurrency 64 \
  --backlog 128 \
  --timeout-graceful-shutdown 20 \
  "${tls_args[@]}"
