# Demo_App_CRM — the complete configuration surface. There is nothing else.
#
# Copy the shape, never this file: a real env file must be named `.env` or
# `.env*.local` so that git ignores it and `scripts/with-env` accepts it.
# This file is deliberately named `.env.example`, which `with-env` refuses.
#
# There is no DATABASE_URL, no auth or signing secret, no APP_URL, no PORT, no
# CA-bundle path and no feature flag. The public HTTPS origin is stored in the
# database by `scripts/manage set-origin`; the TLS trust anchor is baked into
# the image at `app/certs/ca-bundle.pem`; everything else is a code constant.
#
# Values are taken verbatim: no quoting, no escapes, no `$` interpolation.
# Write real values only with `_tools/pgsql/pg env <name> --write <file>`.

# PostgreSQL-wire host, or host:port. A bracketed IPv6 literal is supported:
# <host>, <host>:<port>, [<v6-address>] or [<v6-address>]:<port>.
# No URL, query string or TLS option may appear here.
DB_SERVER=<host-or-host:port>

# Optional. Defaults to 5432. If DB_SERVER also carries a port, the two must
# be identical or startup fails.
DB_PORT=<port>

# Serving uses the DML-only runtime role; one-time maintenance
# (`scripts/manage migrate|bootstrap|set-origin`) uses the owner role. Both
# use these same names, never a sixth one.
DB_USER=<database-role>

# Preserved exactly, never logged, never echoed, never placed on a command
# line and never written into an image.
DB_PASSWORD=<password>

# An existing, dedicated application database. It is never created at startup.
DB_NAME=<database-name>
