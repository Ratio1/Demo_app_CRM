# Build context for `demo-crm-app:local`.
#
# What must NOT be listed here, and why:
#   app/certs/ca-bundle.pem      written by scripts/build-image immediately
#                                before `docker build` and baked into the
#                                image — excluding it would leave the database
#                                connection's `verify-full` with no trust
#                                anchor. It is a CA's public certificate.
# Only `app/certs/roots.dev/` is excluded, so the machine-local dev CA reaches
# a local image through the built bundle and never as a loose directory. The
# image is checked after every build for .env* files, roots.dev/ and .git; none
# of them may be present, and neither may a private key of any kind.

# credentials — never in an image, not even the example
.env*

# version control
.git
.gitignore
.gitattributes

# host-only virtualenv and the uv-managed interpreter pin
.venv
.python-version

# the dev CA source; the built bundle is what ships
app/certs/roots.dev/

# tests and generated documentation evidence
tests/
docs/

# caches and bytecode
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# editor / OS noise
.DS_Store
